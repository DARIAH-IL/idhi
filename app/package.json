{
  "name": "@idhi/app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "VITE_SENTRY_DISABLED=true vite dev",
    "dev:remote": "VITE_SERVER_URL=https://api.idh-index.org pnpm dev",
    "generate-routes": "tsr generate",
    "generate-terms": "node scripts/generate-term-uris.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.ts",
    "i18n-export": "node scripts/i18n-xlsx.mjs export",
    "i18n-import": "node scripts/i18n-xlsx.mjs import",
    "check-form-coverage": "node scripts/check-form-coverage.ts",
    "build": "tsc && vite build && pnpm generate-sitemap",
    "lint": "eslint --fix --max-warnings 0 && i18next-cli lint",
    "format": "prettier --write .",
    "validate": "orval && pnpm generate-terms && pnpm check-form-coverage && pnpm lint && pnpm format && pnpm build",
    "deploy": "VITE_SERVER_URL=https://api.idh-index.org pnpm build && pnpm wrangler pages deploy dist --branch main"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@internationalized/date": "^3.12.4",
    "@sentry/react": "^10.73.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.1",
    "input-otp": "^1.5.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "react-timeago": "^8.3.0",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-query-params": "^2.2.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-plugin": "latest",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "i18next-cli": "^1.72.2",
    "orval": "^8.27.0",
    "prettier": "^3.9.6",
    "sitemap": "^9.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0",
    "xlsx": "^0.18.5"
  }
}
