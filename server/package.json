{
  "name": "@idhi/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "secrets:sync": "wrangler secret bulk .dev.vars",
    "lint": "eslint",
    "format": "prettier --write .",
    "validate": "orval && pnpm format && pnpm lint --fix && pnpm build",
    "test-data:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-test-data.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.12.33",
    "mongoose": "^9.9.3",
    "nodemailer": "^9.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.0.0",
    "orval": "^8.23.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vite": "^8.1.4",
    "wrangler": "^4.124.0"
  }
}
